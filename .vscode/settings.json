{
  // --- C/C++ IntelliSense via clangd ---------------------------------------
  // clangd reads one database at the repo root, which scripts/ide-index.sh
  // merges from ./build and every build-zephyr*/ tree -- run it once after the
  // first builds, and again when a file that compiles shows missing headers.
  // .clangd beside this folder strips the GCC-only flags from the Zephyr half.
  //
  // --query-driver lets clangd run the SDK's cross-compiler to learn its target
  // and system include paths, which is what makes <zephyr/kernel.h>'s own
  // includes resolve. A glob rather than the SDK's path, so it survives an SDK
  // upgrade and another home directory.
  //
  // The host tree, first in the merge, compiles each source in src/ six times:
  // the canonical library and the five variants. clangd takes the first entry
  // for a file, which is the canonical stripseq with no definitions, so src/ --
  // and the headers, which clangd analyses through a source that includes them
  // -- are seen under config.h's declared defaults: white channel off, not the
  // bench's RGBW. Code inside `#if STRIPSEQ_WHITE_CHANNEL` therefore shows as
  // inactive; each test file sees whatever its own variant's target defines.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--query-driver=**/arm-zephyr-eabi-*",
    "--background-index",
    // The library includes only <cstdint> and <cstddef>; letting clangd add
    // headers on completion is how a third one would slip in.
    "--header-insertion=never"
  ],

  // --- DeviceTree + Kconfig (trond-snekvik.*) ------------------------------
  // Absolute paths, so this half describes one machine. VS Code expands neither
  // `~` nor ${userHome} in settings values -- each extension would have to, and
  // these two read their paths raw -- and ${workspaceFolder} is not accepted by
  // devicetree.ctxFile. On another checkout, rewrite the /Users/... prefixes
  // here and in devicetree.json.
  //
  // Both extensions find Zephyr by running `west topdir` in the opened folder.
  // This repo is not inside the west workspace -- ~/zephyr-workspace is, and the
  // samples reach this repo through ZEPHYR_EXTRA_MODULES -- so that lookup
  // fails and both are pointed at it by hand. west lives in the workspace's
  // virtualenv, which is not on VS Code's PATH.
  "devicetree.zephyr": "/Users/esbendn/zephyr-workspace/zephyr",
  "devicetree.west": "/Users/esbendn/zephyr-workspace/.venv/bin/west",
  "devicetree.bindings": [
    "${zephyrBase}/dts/bindings"
  ],
  // One saved context per sample with an overlay: the board's .dts plus that
  // overlay, which is what the extension checks the overlay against. Written
  // by hand because the extension predates Zephyr's hardware model v2: it reads
  // the arch from the first directory under boards/, which is now the vendor
  // (boards/st/...), and then every #include in the board file goes
  // unresolved. A context records the arch outright.
  "devicetree.ctxFile": "/Users/esbendn/Engineering/Projects/StripSequencer/.vscode/devicetree.json",

  "kconfig.zephyr.base": "/Users/esbendn/zephyr-workspace/zephyr",
  "kconfig.zephyr.west": "/Users/esbendn/zephyr-workspace/.venv/bin/west",
  // The board feeds $(BOARD), $(ARCH) and $(BOARD_DIR) to the Kconfig tree.
  // `dir` is spelled out because the extension would otherwise look for the
  // defconfig under boards/<arch>/, where hwmv2 no longer puts it.
  "kconfig.zephyr.board": {
    "board": "nucleo_h753zi",
    "arch": "arm",
    "dir": "/Users/esbendn/zephyr-workspace/zephyr/boards/st/nucleo_h753zi"
  },
  // Zephyr's Kconfig tree reaches the modules -- this repo's zephyr/Kconfig
  // among them -- through files CMake generates per build, so completion in a
  // prj.conf needs a built tree: scripts/sample-build.sh once. These name the
  // bring-up sample; another sample's prj.conf parses against the same tree,
  // which carries the same modules.
  "kconfig.env": {
    "KCONFIG_BINARY_DIR": "${workspaceFolder}/build-zephyr/Kconfig",
    "KCONFIG_BOARD_DIR": "${BOARD_DIR}",
    "APPLICATION_SOURCE_DIR": "${workspaceFolder}/samples/strip_demo"
  },

  // --- CMake ---------------------------------------------------------------
  // scripts/build.sh is the way the host tree is configured: Ninja, ./build,
  // whatever CXX says. CMake Tools would configure the same directory with a
  // kit of its own choosing, and a different compiler in an existing cache
  // makes CMake discard it. The tasks in tasks.json call the scripts instead.
  "cmake.configureOnOpen": false,
  "cmake.automaticReconfigure": false,

  // --- Markdown ------------------------------------------------------------
  // Prose paragraphs are one line each and soft-wrapped by the editor, so a
  // line-length rule would flag every paragraph in the repo.
  "markdownlint.config": {
    "MD013": false
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },

  // --- performance: don't watch build output -------------------------------
  // Every variant, cross-check and Zephyr tree lives under a build*/ directory,
  // and .cache/ is clangd's index.
  "files.watcherExclude": {
    "build*/**": true,
    ".cache/**": true
  },
  "search.exclude": {
    "build*/**": true,
    ".cache/**": true
  }
}
